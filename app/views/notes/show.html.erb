<div class="note-page">
  <header class="note-header">
    <%= link_to "DeepFocus", dashboard_path, class: "note-brand" %>
    <div class="note-header__actions">
      <% if params[:return_to].to_s.start_with?("/") %>
        <%= link_to "Back to timer", params[:return_to], class: "note-btn note-btn--primary" %>
      <% end %>
      <%= link_to "Dashboard", dashboard_path, class: "note-btn note-btn--secondary" %>
      <%= render "delete_button", note: @note %>
      <%= link_to "Edit", edit_note_path(@note, return_to: params[:return_to]), class: "note-btn note-btn--primary" %>
      <%= link_to "All notes", notes_path, class: "note-btn note-btn--secondary" %>
    </div>
  </header>

  <main class="note-shell">
    <section class="note-hero">
      <p class="note-kicker">Saved Note</p>
      <h1 class="note-title"><%= @note.title %></h1>
      <p class="note-copy">
        <%= @note.focus_session&.topic.presence || "General note" %>
        •
        Updated <%= @note.updated_at.strftime("%b %d, %Y %I:%M %p") %>
      </p>
    </section>

    <article class="note-view">
      <%= simple_format(@note.content) %>
    </article>
  </main>
</div>
