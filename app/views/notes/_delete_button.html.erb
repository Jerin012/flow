<%= button_to note_path(note),
    method: :delete,
    class: "note-btn note-btn--danger note-btn--icon",
    form: {
      data: {
        turbo_confirm: "Are you sure you want to delete this note? You can restore it later from the Recycle Bin."
      }
    } do %>
  <span class="note-icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" focusable="false">
      <path d="M9 3h6l1 2h4v2H4V5h4l1-2Zm1 7h2v8h-2v-8Zm4 0h2v8h-2v-8ZM7 10h2v8H7v-8Zm-1 11h12l1-13H5l1 13Z" />
    </svg>
  </span>
  <span class="note-btn__label">Delete</span>
<% end %>
