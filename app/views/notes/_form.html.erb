<% if @note.errors.any? %>
  <div class="note-flash note-flash--error">
    <p>Please fix the errors below.</p>
    <ul>
      <% @note.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<% if flash[:notice].present? %>
  <div class="note-flash note-flash--success"><%= flash[:notice] %></div>
<% end %>

<%= form_with model: @note, local: true, class: "note-form" do |f| %>
  <%= f.hidden_field :focus_session_id %>
  <%= hidden_field_tag :return_to, @return_to if defined?(@return_to) && @return_to.present? %>

  <div class="note-form__group">
    <%= f.label :title, class: "note-form__label" %>
    <%= f.text_field :title, class: "note-form__input", placeholder: "Enter note title" %>
  </div>

  <div class="note-form__group">
    <%= f.label :content, class: "note-form__label" %>
    <%= f.text_area :content, class: "note-form__textarea", placeholder: "Write your note here..." %>
  </div>

  <div class="note-form__actions">
    <%= f.submit(@note.persisted? ? "Save changes" : "Save note", class: "note-btn note-btn--primary") %>
    <% if defined?(@return_to) && @return_to.present? %>
      <%= link_to "Back to timer", @return_to, class: "note-btn note-btn--secondary" %>
    <% else %>
      <%= link_to "Back to notes", notes_path, class: "note-btn note-btn--secondary" %>
    <% end %>
  </div>
<% end %>
