<div class="note-page">
  <header class="note-header">
    <%= link_to "DeepFocus", dashboard_path, class: "note-brand" %>
    <div class="note-header__actions">
      <% if @return_to.present? %>
        <%= link_to "Back to timer", @return_to, class: "note-btn note-btn--primary" %>
      <% end %>
      <%= link_to "Dashboard", dashboard_path, class: "note-btn note-btn--secondary" %>
      <%= link_to "All notes", notes_path, class: "note-btn note-btn--secondary" %>
    </div>
  </header>

  <main class="note-shell">
    <section class="note-hero">
      <p class="note-kicker">Take Note</p>
      <h1 class="note-title"><%= @focus_session&.topic.presence || "Record What You Learned Today" %></h1>
      <p class="note-copy">
        <% if @return_to.present? %>
          Your timer keeps running while you write here. Save the note, then jump back to the live session whenever you want.
        <% else %>
          Capture learning moments before they slip away. Write it once, learn from it forever.
        <% end %>
      </p>
    </section>

    <section class="note-editor">
      <%= render "form" %>
    </section>
  </main>
</div>
